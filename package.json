{
  "name": "timetable-desktop",
  "version": "0.3.3",
  "description": "桌面内嵌侧边栏日程表",
  "author": "timetable",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "dev:sync-a": "electron . --dev --user-data-dir=.\\sandbox\\a --device-name=沙箱A",
    "dev:sync-b": "electron . --dev --user-data-dir=.\\sandbox\\b --device-name=沙箱B",
    "test": "node --test \"tests/*.test.js\"",
    "dist:win": "electron-builder --win nsis",
    "dist:mac": "electron-builder --mac dmg"
  },
  "build": {
    "appId": "com.timetable.sidebar",
    "productName": "日程侧边栏",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "!src/fullscreen-detector.ps1",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/koffi/**",
      "src/services/voice/sapi-recognizer.ps1"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "日程侧边栏",
      "artifactName": "日程侧边栏-${version}-安装程序.exe"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.png"
    },
    "dmg": {
      "artifactName": "TimetableSidebar-${version}-mac-${arch}.dmg"
    }
  },
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "koffi": "^3.2.1"
  }
}
